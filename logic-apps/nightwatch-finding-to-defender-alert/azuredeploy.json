{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "18222150655515375878"
    }
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "nightwatch-finding-to-defender-alert",
      "metadata": {
        "description": "Name of the Logic App."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the Logic App."
      }
    },
    "apiHost": {
      "type": "string",
      "defaultValue": "detections.ai",
      "metadata": {
        "description": "detections.ai API host."
      }
    },
    "apiKey": {
      "type": "securestring",
      "metadata": {
        "description": "A detections.ai API key for the Team whose findings raise alerts."
      }
    },
    "minSeverity": {
      "type": "string",
      "defaultValue": "medium",
      "allowedValues": ["critical", "high", "medium", "low"],
      "metadata": {
        "description": "Only findings at this severity or higher raise an alert."
      }
    },
    "alertCategory": {
      "type": "string",
      "defaultValue": "Execution",
      "metadata": {
        "description": "MITRE ATT&CK tactic recorded as the alert category."
      }
    }
  },
  "variables": {
    "apiBase": "[format('https://{0}/api/v1-beta', parameters('apiHost'))]",
    "newline": "decodeUriComponent('%0A')"
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "parameters": {
          "apiKey": {
            "value": "[parameters('apiKey')]"
          }
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "apiKey": {
              "type": "SecureString"
            }
          },
          "triggers": {
            "When_a_new_Nightwatch_finding_is_published": {
              "type": "HttpWebhook",
              "inputs": {
                "subscribe": {
                  "method": "POST",
                  "uri": "[format('{0}/webhooks/event-types/nightwatch.finding.new/subscribe', variables('apiBase'))]",
                  "headers": {
                    "X-API-Key": "@parameters('apiKey')"
                  },
                  "body": {
                    "url": "@{listCallbackUrl()}",
                    "name": "[format('Logic App {0}', parameters('logicAppName'))]",
                    "min_severity": "[parameters('minSeverity')]"
                  }
                },
                "unsubscribe": {
                  "method": "POST",
                  "uri": "[format('{0}/webhooks/unsubscribe', variables('apiBase'))]",
                  "headers": {
                    "X-API-Key": "@parameters('apiKey')"
                  },
                  "body": {
                    "url": "@{listCallbackUrl()}"
                  }
                }
              }
            }
          },
          "actions": {
            "Map_severity": {
              "type": "Compose",
              "runAfter": {},
              "inputs": "@if(or(equals(triggerBody()?['severity'], 'critical'), equals(triggerBody()?['severity'], 'high')), 'high', if(equals(triggerBody()?['severity'], 'medium'), 'medium', if(equals(triggerBody()?['severity'], 'low'), 'low', 'unknown')))"
            },
            "Map_hosts": {
              "type": "Select",
              "runAfter": {},
              "inputs": {
                "from": "@coalesce(triggerBody()?['hosts'], json('[]'))",
                "select": {
                  "entityType": "device",
                  "entityIdentifier": "deviceName",
                  "identifierValue": "@item()",
                  "role": "impacted"
                }
              }
            },
            "Map_accounts": {
              "type": "Select",
              "runAfter": {},
              "inputs": {
                "from": "@coalesce(triggerBody()?['accounts'], json('[]'))",
                "select": {
                  "entityType": "user",
                  "entityIdentifier": "userPrincipalName",
                  "identifierValue": "@item()",
                  "role": "impacted"
                }
              }
            },
            "Map_calls_to_action": {
              "type": "Select",
              "runAfter": {},
              "inputs": {
                "from": "@coalesce(triggerBody()?['calls_to_action'], json('[]'))",
                "select": "@item()?['title']"
              }
            },
            "Map_report_urls": {
              "type": "Select",
              "runAfter": {},
              "inputs": {
                "from": "@coalesce(triggerBody()?['reports'], json('[]'))",
                "select": "@item()?['url']"
              }
            },
            "Report_url": {
              "type": "Compose",
              "runAfter": {
                "Map_report_urls": ["Succeeded"]
              },
              "inputs": "@{join(take(body('Map_report_urls'), 1), '')}"
            },
            "Create_Defender_alert": {
              "type": "Http",
              "runAfter": {
                "Map_severity": ["Succeeded"],
                "Map_hosts": ["Succeeded"],
                "Map_accounts": ["Succeeded"],
                "Map_calls_to_action": ["Succeeded"],
                "Report_url": ["Succeeded"]
              },
              "inputs": {
                "method": "POST",
                "uri": "https://graph.microsoft.com/beta/security/alerts_v2/createAlert",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                },
                "body": {
                  "createAlertInput": {
                    "title": "@{if(equals(triggerBody()?['test'], true), '[Test] ', '')}@{if(empty(triggerBody()?['title']), 'detections.ai Nightwatch finding', triggerBody()?['title'])}",
                    "description": "[format('@{{concat(if(empty(triggerBody()?[''summary'']), ''detections.ai Nightwatch finding.'', triggerBody()?[''summary'']), {0}, {1}, ''Finding ID: '', coalesce(triggerBody()?[''finding_id''], ''none''), {2}, ''Affected hosts: '', string(coalesce(triggerBody()?[''hosts_count''], 0)), '', accounts: '', string(coalesce(triggerBody()?[''accounts_count''], 0)), if(empty(outputs(''Report_url'')), '''', concat({3}, ''Report: '', outputs(''Report_url''))))}}', variables('newline'), variables('newline'), variables('newline'), variables('newline'))]",
                    "severity": "@{outputs('Map_severity')}",
                    "category": "[parameters('alertCategory')]",
                    "recommendedActions": "[format('@{{join(body(''Map_calls_to_action''), {0})}}', variables('newline'))]",
                    "entityDefinitions": "@union(body('Map_accounts'), body('Map_hosts'))",
                    "mitreTechniques": [],
                    "isExcludedFromCorrelation": true
                  }
                }
              }
            }
          },
          "outputs": {}
        }
      }
    }
  ],
  "outputs": {
    "principalId": {
      "type": "string",
      "metadata": {
        "description": "Object (principal) ID of the Logic App's managed identity. Pass it to grant-graph-permission.ps1."
      },
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'full').identity.principalId]"
    },
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    }
  }
}
